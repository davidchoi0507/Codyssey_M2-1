# ===== 코디세이 (OpenAI 호환) =====
CODYSSEY_API_KEY=
CODYSSEY_BASE_URL=https://copa.codyssey.kr/v1      # 텍스트(OpenAI 호환). 이미지는 https://copa.codyssey.kr/api/v1/images
CODYSSEY_LLM_MODEL=            # 예: gpt-5.4 / claude-sonnet-4 (콘솔 모델 표의 ID). A&R·비주얼·카피·피칭 에이전트용
CODYSSEY_LLM_MODEL_FAST=       # 카피·피칭 등 가벼운 작업용 (선택)
CODYSSEY_IMAGE_MODEL=          # 예: gpt-image-2 / imagen-4. 응답은 response_format=b64_json 으로 받기. dall-e-3 사용 금지 (종료됨)

# ===== Gemini (오디오 듣기) =====
GEMINI_API_KEY=
GEMINI_MODEL=                  # 현재 GA Flash 모델. gemini-2.5-flash 사용 금지
GEMINI_TIER=free               # free | paid  (free면 동의 문구에 학습 가능성 고지)

# ===== 서버 =====
APP_ENV=dev                    # dev | prod
PUBLIC_BASE_URL=https://api.201.n-e.kr
CORS_ORIGINS=http://localhost:3000,https://<vercel-app>.vercel.app
DATA_DIR=./data
DB_PATH=./data/app.db
DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_TOKEN_TTL_SEC=86400

# ===== 한도 =====
MAX_UPLOAD_MB=200
MAX_DURATION_SEC=600
CPU_WORKERS=2
DAILY_JOBS_PER_CLIENT=3
DAILY_JOBS_GLOBAL=60
NOTE_EDITS_PER_JOB=5
COVER_REGEN_PER_JOB=3
RETENTION_DAYS=7

# ===== 미디어 =====
FONT_PATH=./app/fonts/NotoSansKR-Bold.ttf
HIGHLIGHT_SEC=15
CANVAS_SEC=8
